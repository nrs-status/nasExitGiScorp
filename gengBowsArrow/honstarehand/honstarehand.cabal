cabal-version:      2.4
name:               honstarehand
version:            0.1.0.0
synopsis:           Nix-powered run manager for pi microvm jobs
build-type:         Simple

executable honstarehand
    main-is:          Main.hs
    hs-source-dirs:   src
    build-depends:
        base,
        aeson,
        async,
        bytestring,
        containers,
        directory,
        filepath,
        optparse-applicative,
        postgresql-simple,
        process,
        scientific,
        temporary,
        text,
        time,
        tomland,
        unix
    default-language: Haskell2010
    ghc-options:      -threaded -Wall
